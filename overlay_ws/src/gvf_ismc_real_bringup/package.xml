<?xml version="1.0"?>
<package format="3">
  <name>gvf_ismc_real_bringup</name>
  <version>0.0.1</version>
  <description>Project-owned real-hardware bringup for the GVF/ISMC single-drone stack.</description>
  <maintainer email="dev@example.com">Drone SLAM Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>fastlio2_to_ego_swarm_leveling</exec_depend>
  <exec_depend>fastlio2_to_px4_odometry</exec_depend>
  <exec_depend>gvf_ismc_path_following</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>position_cmd_to_px4_bridge</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
