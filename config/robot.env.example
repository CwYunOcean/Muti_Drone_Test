# Copy this file to config/robot.env on each vehicle. The local copy is ignored
# by Git and is the only required identity file for normal launches.

# ROS topic namespace identity. Use the same value in PX4 UXRCE-DDS namespace.
DRONE_ID=1
PX4_DDS_NAMESPACE="drone_${DRONE_ID}"

# PX4 MAV_SYS_ID for this airframe. It is independent of DRONE_ID.
TARGET_SYSTEM=1

# All robots participating in one DDS graph need the same domain id.
ROS_DOMAIN_ID=0
ROS_DISTRO=jazzy
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Hardware-specific files stored only on this robot.
LIVOX_CONFIG_FILE="$ROBOT_CONFIG_REPO_ROOT/config/MID360_config.json"
ROBOT_PARAMS_FILE="$ROBOT_CONFIG_REPO_ROOT/config/robot.params.yaml"
PX4_DIR="$HOME/PX4/PX4-Autopilot"
