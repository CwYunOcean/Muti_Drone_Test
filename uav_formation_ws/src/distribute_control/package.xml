<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
             schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>distribute_control</name>
  <version>0.0.0</version>
  <description>Multi-UAV algorithm package</description>
  <maintainer email="xzr798@todo.todo">xzr798</maintainer>
  <license>MIT</license>

  <!-- ===== Build tools ===== -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- ===== Core dependencies ===== -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>px4_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>

  <!-- ===== TF, visualization, and others ===== -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_eigen</depend>
  <depend>visualization_msgs</depend>
  <depend>trajectory_msgs</depend>

  <!-- ===== Optional ROS 2 components ===== -->
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>pluginlib</depend>
  <depend>class_loader</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>Eigen3</depend>
  
  

  <!-- ===== Launch & description tools ===== -->
  <exec_depend>ros2launch</exec_depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>launch_testing</depend>
  <depend>urdf</depend>
  <depend>xacro</depend>

  <!-- ===== Testing ===== -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <!-- ===== Export ===== -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
